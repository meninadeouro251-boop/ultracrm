API_TITLE="Ultra CRM Agent Processor"
API_DESCRIPTION="Agent Processor for Ultra CRM"
API_VERSION="1.0.0"
API_URL="http://localhost:8000"

ORGANIZATION_NAME="Ultra CRM"
ORGANIZATION_URL="https://ultracrm.com"

# Database settings
POSTGRES_CONNECTION_STRING="postgresql://postgres:root@localhost:5432/ultra_community"

# Fernet encryption key for API keys (shared with ultra-ai-core-service)
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=XoQPOBw2FrzjQS11utERG9qO2MsAnXFxlhIns_uUxRk=

# Logging settings
LOG_LEVEL="INFO"
LOG_DIR="logs"

# Redis settings
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD="your-redis-password"
REDIS_SSL=false
REDIS_KEY_PREFIX="a2a:"
REDIS_TTL=3600

# Tool cache settings
TOOLS_CACHE_ENABLED=true
TOOLS_CACHE_TTL=3600

APP_URL="https://yourdomain.com"

# Ultra CRM API settings (for CRM tools)
# Service token for authenticating with Ultra CRM API
ULTRA_CRM_API_TOKEN=""
# Base URL for Ultra CRM API (defaults to http://localhost:3000)
ULTRA_AI_CRM_URL="http://localhost:3000"

# Server settings
HOST="0.0.0.0"
PORT=8000
DEBUG=false

# ============================================================================
# MEMORY & KNOWLEDGE SERVICES CONFIGURATION
# ============================================================================
# Both memory and knowledge services now use the knowledge microservice via HTTP.
# All Pinecone/Qdrant/OpenSearch configurations have been removed.
# ============================================================================

# Core microservice settings
CORE_SERVICE_URL="http://localhost:9001/api/v1"

